# The attendance device (eSSL / ZKTeco) on the office network. In Keka's Biometric Device Manager these are the IP Address and Port.
DEVICE_IP=192.168.1.58
DEVICE_PORT=4370
DEVICE_NAME=essl-1

# The HR Access Hub that receives the punches, and the secret key (the same value as ATTENDANCE_DEVICE_KEY on the server).
APP_URL=https://hr.wohlig.com
DEVICE_KEY=

# How often to read the device, in seconds.
INTERVAL_SECONDS=300
# On the very first run only punches from this date on are sent (YYYY-MM-DD). Empty = the last 7 days.
SYNC_FROM=
