PORT=3000
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/DBNAME?sslmode=disable
# Optional. Put this app's tables in their own schema, for a database shared with another app. Empty = default schema.
DB_SCHEMA=
# Set to false to skip loading the built-in HR sheet roster on the first start.
SEED_ROSTER=true
# Password given to every new account until the person changes it (HR can change it later on the Users page)
DEFAULT_PASSWORD='Welcome@123'
# First HR login, created on the first start. Comma-separate for several.
HR_ADMIN_EMAIL=shreya.dandare@wohlig.com

# Google Workspace: creates the work email as an active Google account when HR clicks "Create work email".
# Leave both empty to simulate (the flow works, nothing is created in Google).
# GOOGLE_SERVICE_ACCOUNT_FILE is the path to the service account's JSON key. The service account needs
# domain-wide delegation for https://www.googleapis.com/auth/admin.directory.user, and GOOGLE_ADMIN_EMAIL
# is a Workspace super admin it acts as. Never commit the key file.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_ADMIN_EMAIL=

# The address people open the app at. Invite links and the Google sign-in redirect are built from it.
PUBLIC_URL=http://localhost:3000

# Sign in with Google. In Google Cloud Console: APIs and Services > Credentials > Create OAuth client ID > Web application.
# Add this Authorized redirect URI: <PUBLIC_URL>/auth/google/callback  (for example http://localhost:3000/auth/google/callback)
# Leave both empty and the button explains that Google sign-in is not set up yet.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Testing with Mailtrap (https://mailtrap.io): Email Testing > Inboxes > your inbox > SMTP Settings. Mailtrap catches every email in
# a web inbox and delivers nothing to real people. These MAILTRAP_* values win over the SMTP_* ones below, so for real delivery
# later, empty them and fill SMTP_* (or use Mailtrap's "Email Sending" credentials here).
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=
# Where invitation links point (this app, as people open it). Falls back to PUBLIC_URL when empty.
FRONTEND_URL=http://localhost:3000
# Only addresses at this domain can have an account.
ALLOWED_EMAIL_DOMAIN=wohlig.com

# Email: app invites and reimbursement notices both send through these settings.
# Leave SMTP_HOST empty in development. HR then gets the invite link to share, and reimbursement emails are recorded
# in the email_outbox table as "skipped". For Gmail or Google Workspace: smtp.gmail.com, port 587, and an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Wohlig Transformations Private Limited <no-reply@wohlig.com>"
# Remind HR when a reimbursement has waited this many days for review (checked hourly, once a day per claim).
REIMB_REMINDER_DAYS=3
# Small expenses (auto, bus, parking) can be claimed without a receipt up to this amount each, in rupees.
REIMB_NO_RECEIPT_MAX=2000
# Reading invoices: text PDFs are read built in. Set this to the name of an OCR provider added in src/extract.js
# to also read photos and scanned PDFs. Empty = built-in PDF text only.
OCR_PROVIDER=

# Claude access: an Anthropic Admin API key (starts with sk-ant-admin, made in the Claude Console under Admin keys by an
# organization admin). With it, "Give access" on the Employees page invites the person to your Claude organization and
# offboarding removes them. Leave empty to simulate. ANTHROPIC_INVITE_ROLE is the role invites get: user or developer.
ANTHROPIC_ADMIN_KEY=
ANTHROPIC_INVITE_ROLE=user
