PORT=3000
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/DBNAME?sslmode=disable
# Optional. Put this app's tables in their own schema, for a database shared with another app. Empty = default schema.
DB_SCHEMA=
# Set to false to skip loading the built-in HR sheet roster on the first start.
SEED_ROSTER=true
# Set to off on a local copy that uses the shared database, so only the deployed server runs scheduled offboardings,
# invite expiry and review reminders. Empty = on.
BACKGROUND_JOBS=
# Password given to every new account until the person changes it (HR can change it later on the Users page)
DEFAULT_PASSWORD='Welcome@123'
# First HR login, created on the first start. Comma-separate for several.
HR_ADMIN_EMAIL=shreya.dandare@wohlig.com,priyal.makwana@wohlig.com
# Who approves HR staff's own leave and comp off (either one decides). Comma-separate.
HR_LEAVE_APPROVERS=chirag@wohlig.com,chintan@wohlig.com

# Google Workspace: creates the work email as an active Google account when HR clicks "Create work email".
# Leave both empty to simulate (the flow works, nothing is created in Google).
# GOOGLE_SERVICE_ACCOUNT_FILE is the path to the service account's JSON key. The service account needs
# domain-wide delegation for https://www.googleapis.com/auth/admin.directory.user, and GOOGLE_ADMIN_EMAIL
# is a Workspace super admin it acts as. Never commit the key file.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_ADMIN_EMAIL=
# Optional: give each new Workspace user the licence for their mail plan (Starter for everyone, Business for directors and the Vice President).
# Fill in the SKU ids from the Google Admin console / Licensing API. Leave empty to only record the plan. The service account also needs
# domain-wide delegation for https://www.googleapis.com/auth/apps.licensing.
GOOGLE_SKU_STARTER=
GOOGLE_SKU_BUSINESS=
GOOGLE_PRODUCT_ID=Google-Apps

# The address people open the app at. Invite links and the Google sign-in redirect are built from it.
PUBLIC_URL=http://localhost:3000

# Sign in with Google. In Google Cloud Console: APIs and Services > Credentials > Create OAuth client ID > Web application.
# Add this Authorized redirect URI: <PUBLIC_URL>/auth/google/callback  (for example http://localhost:3000/auth/google/callback)
# Leave both empty and the button explains that Google sign-in is not set up yet.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Where invitation links point (this app, as people open it). Falls back to PUBLIC_URL when empty.
FRONTEND_URL=http://localhost:3000
# Only addresses at this domain can have an account.
ALLOWED_EMAIL_DOMAIN=wohlig.com

# Email (SendGrid Web API): app invites and reimbursement notices both send through these settings.
# Leave SENDGRID_API_KEY empty in development. HR then gets the invite link to share, and reimbursement emails are recorded
# in the email_outbox table as "skipped". MAIL_FROM must be a sender or domain verified in SendGrid.
SENDGRID_API_KEY=
SENDGRID_EU=false
MAIL_FROM="Wohlig Transformations Private Limited <no-reply@wohlig.com>"
# Remind HR when a reimbursement has waited this many days for review (checked hourly, once a day per claim).
REIMB_REMINDER_DAYS=3
# Small expenses (auto, bus, parking) can be claimed without a receipt up to this amount each, in rupees.
REIMB_NO_RECEIPT_MAX=2000
# Reading invoices: text PDFs are read built in. Set this to the name of an OCR provider added in src/extract.js
# to also read photos and scanned PDFs. Empty = built-in PDF text only.
OCR_PROVIDER=

# Claude access: an Anthropic Admin API key (starts with sk-ant-admin, made in the Claude Console under Admin keys by an
# organization admin). With it, "Give access" on the Employees page invites the person to your Claude organization and
# offboarding removes them. Leave empty to simulate. ANTHROPIC_INVITE_ROLE is the role invites get: user or developer.
ANTHROPIC_ADMIN_KEY=
ANTHROPIC_INVITE_ROLE=user

# Office biometric device: the small connector program in the office sends punches with this secret key (at least 32 characters).
# Make one with: openssl rand -hex 32     Leave empty to switch device sync off.
ATTENDANCE_DEVICE_KEY=

# Copy office device punches that the Employee Portal received (public.attendance_punches) into this app. Only for a database that
# holds the portal's tables next to this app's schema. true = on, every PORTAL_ATTENDANCE_SYNC_SECONDS (default 300).
PORTAL_ATTENDANCE_SYNC=false
PORTAL_ATTENDANCE_SYNC_SECONDS=300

# Sign-in with email and password, for testing only. true = the sign-in page shows the form and the server accepts it.
# Leave false in production so people sign in with Google.
ALLOW_PASSWORD_LOGIN=false

# ---------------------------------------------------------------------------
# PAYROLL (backend/docs/PAYROLL.md)
# Payroll and payslips on their own database (e.g. a local copy with dummy salaries while everything else uses the shared one).
# Empty = the same database as everything else. PAYROLL_DB_SCHEMA = its schema, if any.
PAYROLL_DATABASE_URL=
PAYROLL_DB_SCHEMA=
# Who reviews and approves each month's payroll (comma separated). They see payroll totals and the Excel report, never bank
# account numbers. Default: chirag@wohlig.com. Someone who sent a payroll for review can't approve it themselves.
PAYROLL_REVIEWERS=chirag@wohlig.com
# Key that encrypts salary bank account numbers and stored bank transfer files (AES-256-GCM). 32 bytes as 64 hex characters:
#   openssl rand -hex 32
# Keep it secret and backed up: without it, stored bank details can't be read. Empty = bank details can't be saved.
PAYROLL_ENCRYPTION_KEY=
# Optional, for the bank transfer file: the company's debit account, and the 4-letter IFSC code of its bank (payments to the
# same bank are marked IFT instead of NEFT).
PAYROLL_DEBIT_ACCOUNT=
PAYROLL_DEBIT_BANK_CODE=
