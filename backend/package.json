{
  "name": "hr-access-hub-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch-path=./src src/index.js",
    "build:ui": "cd ../frontend && npm install && npm run build",
    "test:invites": "node test/invite-flow.mjs",
    "migrate": "node scripts/migrate.mjs",
    "migrate:sql": "node scripts/migrate.mjs --write-sql",
    "test:device": "node test/device-flow.mjs",
    "sync:portal-attendance": "node scripts/sync-portal-attendance.mjs",
    "test": "node --test test/*.test.mjs",
    "check:docs": "node scripts/check-architecture.mjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "google-auth-library": "^9.15.1",
    "pdfkit": "^0.15.2",
    "pg": "^8.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0"
  }
}
